        <script nonce="<?= $cspNonce ?>">
            // Poll for lock release
            (function() {
                async function checkLock() {
                    try {
                        const response = await fetch(adminBasePath + 'shop/categories/action/', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({
                                action: 'check_lock'
                            })
                        });
                        const result = await response.json();

                        if (result.success && !result.locked) {
                            // Lock released - reload page
                            location.reload();
                        }
                    } catch (error) {
                        console.error('Lock check error:', error);
                    }
                }

                setInterval(checkLock, 10000);
            })();
        </script>

{
  "id": "osmium-shop",
  "name": "Osmium Shop",
  "version": "0.29.2",
  "description": "The shop: catalogue, baskets, checkout, orders, discounts and the admin screens that run them",
  "category": "shop",
  "author": {
    "name": "Gavin Cox"
  },
  "license": "proprietary",
  "requires": {
    "osmium": ">=1.0.0",
    "php": ">=8.1",
    "services": []
  },
  "autoload": [],
  "migrations": "migrations/",
  "modules": {
    "basket": "modules/basket",
    "checkout": "modules/checkout",
    "shop": "modules/shop",
    "thank-you": "modules/thank-you"
  },
  "configFiles": {
    "shop": "config-defaults/shop.json.php",
    "checkout": "config-defaults/checkout.json.php"
  },
  "api": {
    "routes": {
      "api/checkout-basket": "api/basket-action.php",
      "api/checkout": "api/checkout-action.php",
      "api/search": "modules/shop/controllers/search-action.php"
    },
    "patterns": {
      "#^api/ai/products/(?<slug>[A-Za-z0-9\\-/]+)\\.(?<format>md|json)$#": "modules/shop/controllers/ai-product-spec.php"
    }
  },
  "hooks": {
    "mcp.tools": [
      "Osmium\\Modules\\Admin\\Services\\BrandMcp::tools",
      "Osmium\\Modules\\Admin\\Services\\DiscountMcp::tools",
      "Osmium\\Modules\\Admin\\Services\\ProductMcp::tools",
      "Osmium\\Modules\\Admin\\Services\\ShopReportsMcp::tools"
    ],
    "service.installed": [
      "Osmium\\Modules\\Admin\\Services\\ShopPages::onEnabled"
    ],
    "service.enabled": [
      "Osmium\\Modules\\Admin\\Services\\ShopPages::onEnabled"
    ],
    "service.disabled": [
      "Osmium\\Modules\\Admin\\Services\\ShopPages::onDisabled"
    ],
    "service.removing": [
      "Osmium\\Modules\\Admin\\Services\\ShopPages::onDisabled"
    ],
    "pages.protected_urls": [
      "Osmium\\Modules\\Admin\\Services\\ShopPages::protectedUrls"
    ],
    "pages.owners": [
      "Osmium\\Modules\\Admin\\Services\\ShopPageLinks::owners"
    ],
    "pages.reserved_ids": [
      "Osmium\\Modules\\Admin\\Services\\ShopPageLinks::reservedIds"
    ],
    "pages.delete_blockers": [
      "Osmium\\Modules\\Admin\\Services\\ShopPageLinks::deleteBlocker"
    ],
    "migrations.actions": [
      "Osmium\\Modules\\Admin\\Services\\ShopSpecRebuild::action"
    ],
    "dashboard.quick_links": [
      "Osmium\\Modules\\Admin\\Services\\ShopDashboardLinks::quickLink"
    ],
    "setup.checklist": [
      "Osmium\\Modules\\Admin\\Services\\ShopDashboardLinks::checklistItem"
    ],
    "email.samples": [
      "Osmium\\Modules\\Checkout\\Services\\ShopEmailSamples::samples"
    ],
    "dashboard.widgets": [
      "Osmium\\Modules\\Admin\\Services\\ShopDashboardWidgets::quickStats",
      "Osmium\\Modules\\Admin\\Services\\ShopDashboardWidgets::baskets"
    ]
  },
  "admin": {
    "models": {
      "status": [
        "Osmium\\Modules\\Admin\\Models\\Status",
        "productstatus"
      ],
      "brand": [
        "Osmium\\Modules\\Admin\\Models\\Brand",
        "productbrands"
      ],
      "basket": [
        "Osmium\\Modules\\Admin\\Models\\Basket",
        "checkout_baskets"
      ],
      "productCategory": [
        "Osmium\\Modules\\Admin\\Models\\ProductCategory",
        "productcategories"
      ],
      "productCategoryAssignment": [
        "Osmium\\Modules\\Admin\\Models\\ProductCategoryAssignment",
        "products_productcategories"
      ],
      "discount": [
        "Osmium\\Modules\\Admin\\Models\\Discount",
        "discounts"
      ],
      "productOptionType": [
        "Osmium\\Modules\\Admin\\Models\\ProductOptionType",
        "productoptiontypes"
      ],
      "productOptionValue": [
        "Osmium\\Modules\\Admin\\Models\\ProductOptionValue",
        "productoptionvalues"
      ],
      "productPriceHistory": [
        "Osmium\\Modules\\Admin\\Models\\ProductPriceHistory",
        "product_price_history"
      ],
      "product": [
        "Osmium\\Modules\\Admin\\Models\\Product",
        "products"
      ],
      "order": [
        "Osmium\\Modules\\Admin\\Models\\Order",
        "shop_orders"
      ]
    },
    "routes": {
      "admin/shop/statuses": {
        "controller": "controllers/StatusesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\StatusesController",
        "method": "index",
        "title": "Statuses"
      },
      "admin/shop/statuses/edit*": {
        "controller": "controllers/StatusesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\StatusesController",
        "method": "edit",
        "title": "Edit Status"
      },
      "admin/shop/statuses/action": {
        "controller": "controllers/StatusesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\StatusesController",
        "method": "action"
      },
      "admin/shop/brands": {
        "controller": "controllers/BrandsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\BrandsController",
        "method": "index",
        "title": "Brands"
      },
      "admin/shop/brands/edit*": {
        "controller": "controllers/BrandsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\BrandsController",
        "method": "edit",
        "title": "Edit Brand"
      },
      "admin/shop/brands/action": {
        "controller": "controllers/BrandsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\BrandsController",
        "method": "action"
      },
      "admin/shop/baskets": {
        "controller": "controllers/BasketsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\BasketsController",
        "method": "index",
        "title": "Baskets"
      },
      "admin/shop/baskets/action": {
        "controller": "controllers/BasketsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\BasketsController",
        "method": "action"
      },
      "admin/shop/categories": {
        "controller": "controllers/ProductCategoriesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductCategoriesController",
        "method": "index",
        "title": "Categories"
      },
      "admin/shop/categories/action": {
        "controller": "controllers/ProductCategoriesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductCategoriesController",
        "method": "action"
      },
      "admin/shop/products/categories/action": {
        "controller": "controllers/ProductCategoryAssignmentController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductCategoryAssignmentController",
        "method": "action"
      },
      "admin/shop/discounts": {
        "controller": "controllers/DiscountsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\DiscountsController",
        "method": "index",
        "title": "Discounts"
      },
      "admin/shop/discounts/edit*": {
        "controller": "controllers/DiscountsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\DiscountsController",
        "method": "edit",
        "title": "Edit Discount"
      },
      "admin/shop/discounts/action": {
        "controller": "controllers/DiscountsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\DiscountsController",
        "method": "action"
      },
      "admin/shop/products/price-history": {
        "controller": "controllers/ProductPriceHistoryController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductPriceHistoryController",
        "method": "index",
        "title": "Price History"
      },
      "admin/shop/products/price-history/action": {
        "controller": "controllers/ProductPriceHistoryController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductPriceHistoryController",
        "method": "action"
      },
      "admin/shop/products/options": {
        "controller": "controllers/ProductOptionsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductOptionsController",
        "method": "index",
        "title": "Product Options"
      },
      "admin/shop/products/options/action": {
        "controller": "controllers/ProductOptionsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductOptionsController",
        "method": "action"
      },
      "admin/shop/products/images": {
        "controller": "controllers/ProductImagesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductImagesController",
        "method": "index",
        "title": "Product Images"
      },
      "admin/shop/products/images/action": {
        "controller": "controllers/ProductImagesController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductImagesController",
        "method": "action"
      },
      "admin/shop/products": {
        "controller": "controllers/ProductsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductsController",
        "method": "index",
        "title": "Products"
      },
      "admin/shop/products/action": {
        "controller": "controllers/ProductsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductsController",
        "method": "action"
      },
      "admin/shop/products/edit*": {
        "controller": "controllers/ProductsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductsController",
        "method": "edit",
        "title": "Edit Product"
      },
      "admin/shop/products/add": {
        "controller": "controllers/ProductsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductsController",
        "method": "add",
        "title": "Add Product"
      },
      "admin/shop/products/export": {
        "controller": "controllers/ProductsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductsController",
        "method": "export",
        "title": "Export Products"
      },
      "admin/shop/products/import": {
        "controller": "controllers/ProductsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ProductsController",
        "method": "import",
        "title": "Import Products"
      },
      "admin/shop/orders": {
        "controller": "controllers/OrdersController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\OrdersController",
        "method": "index",
        "title": "Orders"
      },
      "admin/shop/orders/view": {
        "controller": "controllers/OrdersController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\OrdersController",
        "method": "view",
        "title": "Order"
      },
      "admin/shop/orders/despatch-note": {
        "controller": "controllers/OrdersController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\OrdersController",
        "method": "despatchNote",
        "title": "Despatch Note"
      },
      "admin/shop/orders/invoice": {
        "controller": "controllers/OrdersController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\OrdersController",
        "method": "invoice",
        "title": "Invoice"
      },
      "admin/shop/orders/action": {
        "controller": "controllers/OrdersController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\OrdersController",
        "method": "action"
      },
      "admin/settings/shop": {
        "controller": "controllers/ShopSettingsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\ShopSettingsController",
        "method": "index",
        "title": "Shop Settings"
      },
      "admin/settings/payments": {
        "controller": "controllers/PaymentSettingsController.php",
        "class": "Osmium\\Modules\\Admin\\Controllers\\PaymentSettingsController",
        "method": "index",
        "title": "Payment Settings"
      }
    },
    "menu": {
      "section": "Shop",
      "group": {
        "id": "shop",
        "label": "Shop",
        "icon": "bx bx-store",
        "color": "#dc3545",
        "order": 30
      },
      "items": [
        {
          "id": "products",
          "label": "Products",
          "placement": "group",
          "group": "shop",
          "order": 10,
          "route": "admin/shop/products",
          "activePattern": "admin/shop/products*",
          "activeExcept": "admin/shop/products/price-history",
          "role": null
        },
        {
          "id": "categories",
          "label": "Categories",
          "placement": "group",
          "group": "shop",
          "order": 20,
          "route": "admin/shop/categories",
          "activePattern": "admin/shop/categories*",
          "role": null
        },
        {
          "id": "brands",
          "label": "Brands",
          "placement": "group",
          "group": "shop",
          "order": 30,
          "route": "admin/shop/brands",
          "activePattern": "admin/shop/brands*",
          "role": null
        },
        {
          "id": "statuses",
          "label": "Statuses",
          "placement": "group",
          "group": "shop",
          "order": 40,
          "route": "admin/shop/statuses",
          "activePattern": "admin/shop/statuses*",
          "role": null
        },
        {
          "id": "discounts",
          "label": "Discounts",
          "placement": "group",
          "group": "shop",
          "order": 50,
          "route": "admin/shop/discounts",
          "activePattern": "admin/shop/discounts*",
          "role": null
        },
        {
          "id": "orders",
          "label": "Orders",
          "placement": "group",
          "group": "shop",
          "order": 60,
          "route": "admin/shop/orders",
          "activePattern": "admin/shop/orders*",
          "role": null
        },
        {
          "id": "baskets",
          "label": "Baskets",
          "placement": "group",
          "group": "shop",
          "order": 70,
          "route": "admin/shop/baskets",
          "activePattern": "admin/shop/baskets",
          "role": null
        },
        {
          "id": "price-history",
          "label": "Price History",
          "placement": "group",
          "group": "shop",
          "order": 80,
          "route": "admin/shop/products/price-history",
          "activePattern": "admin/shop/products/price-history",
          "role": null
        },
        {
          "id": "shop-settings",
          "label": "Settings",
          "placement": "group",
          "group": "shop",
          "order": 200,
          "route": "admin/settings/shop",
          "activePattern": "admin/settings/shop",
          "role": "admin"
        },
        {
          "id": "payments",
          "label": "Payments",
          "placement": "group",
          "group": "shop",
          "order": 210,
          "route": "admin/settings/payments",
          "activePattern": "admin/settings/payments",
          "role": "admin"
        }
      ]
    }
  }
}
